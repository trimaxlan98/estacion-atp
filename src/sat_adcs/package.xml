<?xml version="1.0"?>
<package format="3">
  <name>sat_adcs</name>
  <version>0.1.0</version>
  <description>ADCS de un CubeSat 3U (segmento espacio de la Estacion ATP): dinamica, estimacion, control y modos de mision en lockstep</description>
  <maintainer email="contacto@codeaerospace.com">code</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sat_interfaces</depend>
  <depend>atp_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
