<?xml version="1.0"?>
<package format="3">
  <name>atp_mcu</name>
  <version>0.1.0</version>
  <description>ATP microcontrolador en el lazo: fusiona los ejes de los ESP32 (micro-ROS) en /joint_states y decodifica su diagnostico</description>
  <maintainer email="contacto@codeaerospace.com">code</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <exec_depend>atp_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
