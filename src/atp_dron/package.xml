<?xml version="1.0"?>
<package format="3">
  <name>atp_dron</name>
  <version>0.1.0</version>
  <description>Dron multirrotor: dinamica 6-DOF de un cuadrirrotor con atmosfera y viento por cuerpo, sensores y estimador, control en cascada, seguimiento de ruta y nodos ROS en lockstep (nucleo sin ROS)</description>
  <maintainer email="contacto@codeaerospace.com">code</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>atp_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
