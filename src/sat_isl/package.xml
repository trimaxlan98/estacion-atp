<?xml version="1.0"?>
<package format="3">
  <name>sat_isl</name>
  <version>0.1.0</version>
  <description>ATP optico entre satelites (ISL) en una constelacion: geometria, terminal grueso/fino, adquisicion, seguimiento y presupuesto de enlace, en lockstep</description>
  <maintainer email="contacto@codeaerospace.com">code</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>isl_interfaces</depend>
  <depend>atp_ros</depend>
  <depend>sat_adcs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
