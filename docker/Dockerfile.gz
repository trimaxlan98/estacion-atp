# Imagen ros2-jazzy-gz: ros2-jazzy-dev + ros2_control + Gazebo Harmonic (gz sim 8).
# Aditiva: NO toca docker/Dockerfile. Equipo K (ros2_control y Gazebo).
# Construir: docker compose build gz   (la imagen base ros2-jazzy-dev debe existir)
FROM ros2-jazzy-dev

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-ros2-control ros-jazzy-ros2-controllers ros-jazzy-controller-manager \
      ros-jazzy-hardware-interface ros-jazzy-controller-interface \
      ros-jazzy-joint-state-broadcaster ros-jazzy-joint-trajectory-controller \
      ros-jazzy-xacro ros-jazzy-ros-gz ros-jazzy-gz-ros2-control \
      mesa-utils \
    && rm -rf /var/lib/apt/lists/*

USER dev
WORKDIR /ws
CMD ["bash"]
